# Copy to ".env" (never commit .env). Values here are local-development placeholders, not secrets.
# docker compose reads this file automatically. Spring Boot does NOT read .env by itself: either keep the
# defaults below (they match application.yml) or export the same variables before starting the backend.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=codetrace
POSTGRES_USER=codetrace
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Backend (Spring Boot environment variables) ---
DB_URL=jdbc:postgresql://localhost:5432/codetrace
DB_USERNAME=codetrace
DB_PASSWORD=change_me
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_FILES=50
UPLOAD_MAX_FILE_BYTES=524288
# Keep source text so the side-by-side comparison view works after the upload (true/false)
RETENTION_STORE_SOURCE=true
# Delete analyses older than N days automatically (0 = keep until deleted manually)
RETENTION_DAYS=30

# --- Optional: run integration tests against an existing database instead of Testcontainers ---
# WARNING: the tests delete all analyses in that database. Use a dedicated test database.
# TEST_DB_URL=jdbc:postgresql://localhost:5432/codetrace_test
# TEST_DB_USERNAME=codetrace
# TEST_DB_PASSWORD=codetrace
